import Jacobian.Periods.PathIntegralViaCoverPick
import Jacobian.Periods.PathIntegralViaCoverPickRefl
import Jacobian.HolomorphicForms.BasisAlignedDualEquiv
import Jacobian.ComplexTorus.Defs
import Mathlib.Algebra.Module.ZLattice.Basic

/-!
# The genuine period lattice

This file defines the period lattice of a compact Riemann surface by **integrating
holomorphic 1-forms over closed curves**, replacing the former placeholder in which the
period pairing was the zero map (so that the "lattice" was `⊥` and the Jacobian was all
of `ℂ^g`).

## The line integral

The integral of a holomorphic 1-form `ω` along a path `γ : Path P Q` is the existing
multi-chart integral `pathIntegralViaCover ω γ`
(`Jacobian/Periods/PathIntegralViaCoverPick.lean`): `γ` is cut into finitely many
segments, each inside one chart, and on each segment one integrates the genuine chart
pullback `ω(c⁻¹ e) ∘ D(c⁻¹)(e)` (`chartedFormPullback`) along the chart image of the
segment, i.e. `∫ ω(γ t)(γ' t) dt` written in coordinates. For a path that is `C¹` in
every chart (`IsC1Path` below) this value does not depend on the subdivision or the
charts (`pathIntegralViaCoverWith_refinement_invariant'`,
`pathIntegralViaChartCorrect_chart_change`).

## The period lattice

Fix the basis `ω₁, …, ω_g` of `HolomorphicOneForm ℂ X` used throughout the project
(`holomorphicOneFormFinBasis`), so that `Fin g → ℂ` is the basis-aligned model of the
dual `H⁰(X, Ω¹)^*`. The **period vector** of a path is `(∫_γ ω₁, …, ∫_γ ω_g)`.

A *period* is the period vector of a closed `C¹` curve. We generate the lattice by the
differences `periodVector γ₁ - periodVector γ₂` of two `C¹` paths `γ₁ γ₂ : Path P Q`
with the same endpoints — the integral around the closed curve `γ₁ · γ₂⁻¹`. Closed
`C¹` loops are the special case `γ₂ = refl` (`periodVector_mem_of_loop`). Generating by
differences makes "the Abel–Jacobi integral is well defined modulo periods" hold by
definition, which is exactly how the classical construction is phrased. Classically this
subgroup is the image of `H₁(X, ℤ)` under integration.

## Classical input

That this subgroup is a full lattice in `ℂ^g` (discrete, and spanning `ℂ^g ≅ ℝ^{2g}`
over `ℝ`) is the classical theorem on the period lattice (Riemann's bilinear relations;
O. Forster, *Lectures on Riemann Surfaces*, §21; Griffiths–Harris, *Principles of
Algebraic Geometry*, Ch. 2 §2). It is recorded as the single named classical
input `periodLattice_discrete_and_span` (a `sorry`'d theorem, listed in
`ref/axiom-audit.md`). Everything else in this file is proved.
-/

namespace JacobianChallenge.Periods

open JacobianChallenge.HolomorphicForms

universe u

section Paths

variable {X : Type u} [TopologicalSpace X] [ChartedSpace ℂ X]
  [IsManifold (modelWithCornersSelf ℂ ℂ) (⊤ : WithTop ℕ∞) X]

/--
A path is `C¹` if it is continuously differentiable (over `ℝ`) in every chart, on the
part of `[0, 1]` that the chart sees. This is the regularity under which the multi-chart
line integral is independent of the chosen subdivision
(`pathIntegralViaCoverWith_refinement_invariant'`).
-/
def IsC1Path {P Q : X} (γ : Path P Q) : Prop :=
  ∀ p : X, ContDiffOn ℝ 1 ((chartAt ℂ p) ∘ γ.extend)
    (γ.extend ⁻¹' (chartAt ℂ p).source ∩ Set.Icc 0 1)

/-- The constant path is `C¹`. -/
theorem isC1Path_refl (P : X) : IsC1Path (Path.refl P) := by
  intro p
  have : ((chartAt ℂ p) ∘ (Path.refl P).extend) = fun _ => (chartAt ℂ p) P := by
    funext t
    simp [Path.extend, Set.IccExtend]
  rw [this]
  exact contDiffOn_const

/-- The line integral `∫_γ ω` of a holomorphic 1-form along a path. -/
noncomputable def lineIntegral (ω : HolomorphicOneForm ℂ X) {P Q : X} (γ : Path P Q) : ℂ :=
  pathIntegralViaCover ω γ

@[simp] theorem lineIntegral_refl (ω : HolomorphicOneForm ℂ X) (P : X) :
    lineIntegral ω (Path.refl P) = 0 :=
  pathIntegralViaCover_refl ω P

end Paths

variable (X : Type u) [TopologicalSpace X] [ChartedSpace ℂ X]
  [IsManifold (modelWithCornersSelf ℂ ℂ) (⊤ : WithTop ℕ∞) X]
  [FiniteDimensionalHolomorphicOneForms ℂ X]

/--
The period vector of a path: its line integrals against the chosen basis
`ω₁, …, ω_g` of holomorphic 1-forms, `(∫_γ ω₁, …, ∫_γ ω_g) ∈ ℂ^g`.
-/
noncomputable def periodVector {P Q : X} (γ : Path P Q) : Fin (analyticGenus ℂ X) → ℂ :=
  fun i => lineIntegral (holomorphicOneFormFinBasis ℂ X i) γ

@[simp] theorem periodVector_refl (P : X) : periodVector X (Path.refl P) = 0 := by
  funext i
  simp [periodVector]

/--
The generators of the period lattice: differences of the period vectors of two `C¹`
paths with the same endpoints, i.e. integrals over the closed curve `γ₁ · γ₂⁻¹`.
-/
def periodGenerators : Set (Fin (analyticGenus ℂ X) → ℂ) :=
  {v | ∃ (P Q : X) (γ₁ γ₂ : Path P Q), IsC1Path γ₁ ∧ IsC1Path γ₂ ∧
    v = periodVector X γ₁ - periodVector X γ₂}

/--
**The period lattice** `Λ ⊆ ℂ^g`: the subgroup generated by the integrals of the basis
forms over closed `C¹` curves (presented as differences of two paths with common
endpoints). Classically, the image of `H₁(X, ℤ)` under integration.
-/
noncomputable def genuinePeriodSubgroup : AddSubgroup (Fin (analyticGenus ℂ X) → ℂ) :=
  AddSubgroup.closure (periodGenerators X)

variable {X}

/-- Two `C¹` paths with the same endpoints have period vectors differing by a period. -/
theorem periodVector_sub_mem {P Q : X} {γ₁ γ₂ : Path P Q}
    (h₁ : IsC1Path γ₁) (h₂ : IsC1Path γ₂) :
    periodVector X γ₁ - periodVector X γ₂ ∈ genuinePeriodSubgroup X :=
  AddSubgroup.subset_closure ⟨P, Q, γ₁, γ₂, h₁, h₂, rfl⟩

/-- The period vector of a closed `C¹` loop is a period. -/
theorem periodVector_mem_of_loop {P : X} {γ : Path P P} (h : IsC1Path γ) :
    periodVector X γ ∈ genuinePeriodSubgroup X := by
  have h' := periodVector_sub_mem h (isC1Path_refl P)
  rwa [periodVector_refl, sub_zero] at h'

variable (X) [T2Space X] [CompactSpace X] [ConnectedSpace X]

/--
**CLASSICAL INPUT — the period lattice is a full lattice.** For a compact connected
Riemann surface the period subgroup `Λ ⊆ ℂ^g` is discrete and spans `ℂ^g` over `ℝ`
(so `Λ ≅ ℤ^{2g}` and `ℂ^g / Λ` is a compact complex torus).

References: Riemann's bilinear relations; O. Forster, *Lectures on Riemann Surfaces*,
§21; P. Griffiths–J. Harris, *Principles of Algebraic Geometry*, Ch. 2 §2.

Named classical input (`sorry`); see `ref/axiom-audit.md`, "Classical inputs".
-/
theorem periodLattice_discrete_and_span :
    DiscreteTopology (genuinePeriodSubgroup X) ∧
      Submodule.span ℝ (genuinePeriodSubgroup X : Set (Fin (analyticGenus ℂ X) → ℂ)) = ⊤ := by
  -- CLASSICAL INPUT: discreteness and fullness of the period lattice.
  sorry

/-- The period subgroup as a `ℤ`-submodule. -/
noncomputable def genuinePeriodSubmodule : Submodule ℤ (Fin (analyticGenus ℂ X) → ℂ) :=
  AddSubgroup.toIntSubmodule (genuinePeriodSubgroup X)

instance genuinePeriodSubgroup_discrete : DiscreteTopology (genuinePeriodSubgroup X) :=
  (periodLattice_discrete_and_span X).1

instance genuinePeriodSubmodule_discrete : DiscreteTopology (genuinePeriodSubmodule X) :=
  (periodLattice_discrete_and_span X).1

instance genuinePeriodSubmodule_isZLattice : IsZLattice ℝ (genuinePeriodSubmodule X) where
  span_top := (periodLattice_discrete_and_span X).2

/--
A compact fundamental domain for the period lattice: the closure of the parallelepiped
spanned by a `ℤ`-basis of `Λ` (which exists because `Λ` is a full lattice).
-/
theorem exists_compact_genuinePeriodFundamentalDomain :
    ∃ D : Set (Fin (analyticGenus ℂ X) → ℂ),
      IsCompact D ∧
      ∀ v : Fin (analyticGenus ℂ X) → ℂ, ∃ g ∈ genuinePeriodSubgroup X, v - g ∈ D := by
  haveI := ZLattice.module_free ℝ (genuinePeriodSubmodule X)
  haveI := ZLattice.module_finite ℝ (genuinePeriodSubmodule X)
  let bℤ : Module.Basis _ ℤ (genuinePeriodSubmodule X) := Module.Free.chooseBasis ℤ _
  let bR : Module.Basis _ ℝ (Fin (analyticGenus ℂ X) → ℂ) := bℤ.ofZLatticeBasis ℝ _
  refine ⟨closure (ZSpan.fundamentalDomain bR),
    (ZSpan.fundamentalDomain_isBounded bR).isCompact_closure, fun v => ?_⟩
  refine ⟨(ZSpan.floor bR v : Fin _ → ℂ), ?_, ?_⟩
  · have hmem : (ZSpan.floor bR v : Fin _ → ℂ) ∈ Submodule.span ℤ (Set.range bR) :=
      (ZSpan.floor bR v).property
    have hSub : genuinePeriodSubmodule X = Submodule.span ℤ (Set.range bR) :=
      (Module.Basis.ofZLatticeBasis_span (K := ℝ) (b := bℤ)).symm
    exact (SetLike.ext_iff.mp hSub _).mpr hmem
  · rw [show v - (ZSpan.floor bR v : Fin _ → ℂ) = ZSpan.fract bR v from
      (ZSpan.fract_apply bR v).symm]
    exact subset_closure (ZSpan.fract_mem_fundamentalDomain bR v)

/--
**The period lattice of a compact Riemann surface**, bundled as a
`ComplexTorus.FullComplexLattice` in the basis-aligned model `ℂ^g`. Its carrier is the
genuine `genuinePeriodSubgroup X`; discreteness and cocompactness come from the classical
input `periodLattice_discrete_and_span`.
-/
noncomputable def genuinePeriodLattice :
    JacobianChallenge.ComplexTorus.FullComplexLattice (Fin (analyticGenus ℂ X) → ℂ) where
  subgroup := genuinePeriodSubgroup X
  isClosed := AddSubgroup.isClosed_of_discrete
  isDiscrete := genuinePeriodSubgroup_discrete X
  fundamentalDomain := (exists_compact_genuinePeriodFundamentalDomain X).choose
  fundamentalDomain_isCompact := (exists_compact_genuinePeriodFundamentalDomain X).choose_spec.1
  fundamentalDomain_covers := (exists_compact_genuinePeriodFundamentalDomain X).choose_spec.2

@[simp] theorem genuinePeriodLattice_subgroup :
    (genuinePeriodLattice X).subgroup = genuinePeriodSubgroup X := rfl

end JacobianChallenge.Periods
