import Jacobian.Periods.ChartChain
import Jacobian.Periods.RealPeriods
import Jacobian.HolomorphicForms.BasisAlignedDualEquiv
import Jacobian.ComplexTorus.Defs
import Mathlib.Algebra.Module.ZLattice.Basic

/-!
# The genuine period lattice

This file defines the period lattice of a compact Riemann surface by **integrating
holomorphic 1-forms over closed curves**, replacing the former placeholder in which the
period pairing was the zero map (so that the "lattice" was `⊥` and the Jacobian was all
of `ℂ^g`).

## The line integral

The integral of a holomorphic 1-form `ω` along a **chart chain** — a finite list of
straight segments, each inside a ball in one chart target, glued end to end
(`Jacobian/Periods/ChartChain.lean`) — is the sum over the segments of the curve integral
of the chart reading `ω(c⁻¹ e) ∘ D(c⁻¹)(e)`, i.e. the classical `∫ ω(γ t)(γ' t) dt` along
the piecewise-smooth curve, written in charts. Chains concatenate by list append and any
two points of a connected surface are joined by one (`exists_chain`).

## The period lattice

Fix the basis `ω₁, …, ω_g` of `HolomorphicOneForm ℂ X` used throughout the project
(`holomorphicOneFormFinBasis`), so that `Fin g → ℂ` is the basis-aligned model of the
dual `H⁰(X, Ω¹)^*`. The **period vector** of a chain is `(∫ ω₁, …, ∫ ω_g)`.

A *period* is the period vector of a closed chain. We generate the lattice by the
differences `periodVector l₁ - periodVector l₂` of two chains with the same endpoints —
the integral around the closed curve `l₁ · l₂⁻¹`. Closed chains are the special case
`l₂ = []` (`periodVector_mem_of_loop`). Generating by differences makes "the Abel–Jacobi
integral is well defined modulo periods" hold by definition, which is exactly how the
classical construction is phrased. Classically this subgroup is the image of `H₁(X, ℤ)`
under integration (every class is represented by a closed chain of chart segments).

## Classical input

That this subgroup is a full lattice in `ℂ^g` (discrete, and spanning `ℂ^g ≅ ℝ^{2g}`
over `ℝ`) is the classical theorem on the period lattice (Riemann's bilinear relations;
O. Forster, *Lectures on Riemann Surfaces*, §21; Griffiths–Harris, *Principles of
Algebraic Geometry*, Ch. 2 §2). It is recorded as the single named classical
input `periodLattice_discrete_and_span` (a `sorry`'d theorem, listed in
`ref/axiom-audit.md`). Everything else in this file is proved.
-/

namespace JacobianChallenge.Periods

open JacobianChallenge.HolomorphicForms

universe u

variable (X : Type u) [TopologicalSpace X] [ChartedSpace ℂ X]
  [IsManifold (modelWithCornersSelf ℂ ℂ) (⊤ : WithTop ℕ∞) X]
  [FiniteDimensionalHolomorphicOneForms ℂ X]

/--
The period vector of a chart chain: its line integrals against the chosen basis
`ω₁, …, ω_g` of holomorphic 1-forms, `(∫_l ω₁, …, ∫_l ω_g) ∈ ℂ^g`.
-/
noncomputable def periodVector (l : List (ChartSegment X)) : Fin (analyticGenus ℂ X) → ℂ :=
  fun i => chainIntegral (holomorphicOneFormFinBasis ℂ X i) l

@[simp] theorem periodVector_nil : periodVector X [] = 0 := by
  funext i
  simp [periodVector]

theorem periodVector_append (l₁ l₂ : List (ChartSegment X)) :
    periodVector X (l₁ ++ l₂) = periodVector X l₁ + periodVector X l₂ := by
  funext i
  simp only [periodVector, chainIntegral_append, Pi.add_apply]

/--
The generators of the period lattice: differences of the period vectors of two chart
chains with the same endpoints, i.e. integrals over the closed curve `l₁ · l₂⁻¹`.
-/
def periodGenerators : Set (Fin (analyticGenus ℂ X) → ℂ) :=
  {v | ∃ (P Q : X) (l₁ l₂ : List (ChartSegment X)), IsChain l₁ P Q ∧ IsChain l₂ P Q ∧
    v = periodVector X l₁ - periodVector X l₂}

/--
**The period lattice** `Λ ⊆ ℂ^g`: the subgroup generated by the integrals of the basis
forms over closed chart chains (presented as differences of two chains with common
endpoints). Classically, the image of `H₁(X, ℤ)` under integration.
-/
noncomputable def genuinePeriodSubgroup : AddSubgroup (Fin (analyticGenus ℂ X) → ℂ) :=
  AddSubgroup.closure (periodGenerators X)

variable {X}

/-- Two chains with the same endpoints have period vectors differing by a period. -/
theorem periodVector_sub_mem {P Q : X} {l₁ l₂ : List (ChartSegment X)}
    (h₁ : IsChain l₁ P Q) (h₂ : IsChain l₂ P Q) :
    periodVector X l₁ - periodVector X l₂ ∈ genuinePeriodSubgroup X :=
  AddSubgroup.subset_closure ⟨P, Q, l₁, l₂, h₁, h₂, rfl⟩

/-- The period vector of a closed chain is a period. -/
theorem periodVector_mem_of_loop {P : X} {l : List (ChartSegment X)} (h : IsChain l P P) :
    periodVector X l ∈ genuinePeriodSubgroup X := by
  have h' := periodVector_sub_mem h (show IsChain [] P P from rfl)
  rwa [periodVector_nil, sub_zero] at h'

variable (X) [T2Space X] [CompactSpace X] [ConnectedSpace X]

/--
**The periods span `ℂ^g` over `ℝ`.** If a real functional `φ` killed every period, write
`φ(v) = Re Σ c_j v_j`; the form `ω = Σ c_j ω_j` then has integrals with path-independent real
part, so `ω = 0` (`eq_zero_of_re_chainIntegral_eq`, a maximum-principle argument), hence
`c = 0` and `φ = 0`.
-/
theorem periodLattice_span :
    Submodule.span ℝ (genuinePeriodSubgroup X : Set (Fin (analyticGenus ℂ X) → ℂ)) = ⊤ := by
  classical
  by_contra hne
  obtain ⟨φ, hφ0, hle⟩ := (Submodule.span ℝ (genuinePeriodSubgroup X :
    Set (Fin (analyticGenus ℂ X) → ℂ))).exists_le_ker_of_lt_top (lt_top_iff_ne_top.mpr hne)
  set b := holomorphicOneFormFinBasis ℂ X
  set c : Fin (analyticGenus ℂ X) → ℂ := fun j =>
    (φ (Pi.single j 1) : ℂ) - Complex.I * (φ (Pi.single j Complex.I) : ℂ)
  have hφ : ∀ v, φ v = (∑ j, c j * v j).re := by
    intro v
    have hv : v = ∑ j, ((v j).re • (Pi.single j (1 : ℂ) : Fin (analyticGenus ℂ X) → ℂ) +
        (v j).im • (Pi.single j Complex.I : Fin (analyticGenus ℂ X) → ℂ)) := by
      funext k
      simp only [Finset.sum_apply, Pi.add_apply, Pi.smul_apply, Pi.single_apply,
        Finset.sum_add_distrib]
      simp [Complex.re_add_im]
    conv_lhs => rw [hv]
    rw [map_sum, Complex.re_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
    simp only [c, Complex.mul_re, Complex.sub_re, Complex.sub_im, Complex.ofReal_re,
      Complex.ofReal_im, Complex.mul_im, Complex.I_re, Complex.I_im]
    ring
  set ω : HolomorphicOneForm ℂ X := ∑ j, c j • b j
  have hint : ∀ l, chainIntegral ω l = ∑ j, c j * periodVector X l j := by
    intro l
    rw [← chainIntegralLM_apply, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_smul, chainIntegralLM_apply, smul_eq_mul]
    rfl
  have hzero : ω = 0 := eq_zero_of_re_chainIntegral_eq ω fun P Q l₁ l₂ h₁ h₂ => by
    have hmem := periodVector_sub_mem h₁ h₂
    have h0 : φ (periodVector X l₁ - periodVector X l₂) = 0 :=
      LinearMap.mem_ker.mp (hle (Submodule.subset_span hmem))
    rw [map_sub, hφ, hφ, sub_eq_zero] at h0
    rw [hint, hint]
    exact h0
  have hc : ∀ j, c j = 0 := (Fintype.linearIndependent_iff.mp b.linearIndependent) c hzero
  apply hφ0
  refine LinearMap.ext fun v => ?_
  rw [hφ v]
  simp [hc]
  rfl

/--
**CLASSICAL INPUT — the period lattice is discrete.** For a compact connected Riemann
surface the period subgroup `Λ ⊆ ℂ^g` is discrete. (That it spans `ℂ^g` over `ℝ` is proved:
`periodLattice_span`.) Classically: `Λ` is the image of `H₁(X, ℤ) ≅ ℤ^{2g}`, so it is generated
by `2g` vectors spanning `ℝ^{2g}`, hence a lattice; the rank count `b₁ = 2g` is the
Hodge/Dolbeault decomposition `H¹(X, ℂ) = H⁰(Ω¹) ⊕ \overline{H⁰(Ω¹)}`.

References: O. Forster, *Lectures on Riemann Surfaces*, §21; P. Griffiths–J. Harris,
*Principles of Algebraic Geometry*, Ch. 2 §2.

Named classical input (`sorry`); see `ref/axiom-audit.md`, "Classical inputs".
-/
theorem periodLattice_discrete : DiscreteTopology (genuinePeriodSubgroup X) := by
  -- CLASSICAL INPUT: discreteness of the period lattice.
  sorry

/-- The period subgroup is a full lattice: discrete (`periodLattice_discrete`) and spanning
(`periodLattice_span`). -/
theorem periodLattice_discrete_and_span :
    DiscreteTopology (genuinePeriodSubgroup X) ∧
      Submodule.span ℝ (genuinePeriodSubgroup X : Set (Fin (analyticGenus ℂ X) → ℂ)) = ⊤ :=
  ⟨periodLattice_discrete X, periodLattice_span X⟩

/-- The period subgroup as a `ℤ`-submodule. -/
noncomputable def genuinePeriodSubmodule : Submodule ℤ (Fin (analyticGenus ℂ X) → ℂ) :=
  AddSubgroup.toIntSubmodule (genuinePeriodSubgroup X)

instance genuinePeriodSubgroup_discrete : DiscreteTopology (genuinePeriodSubgroup X) :=
  (periodLattice_discrete_and_span X).1

instance genuinePeriodSubmodule_discrete : DiscreteTopology (genuinePeriodSubmodule X) :=
  (periodLattice_discrete_and_span X).1

instance genuinePeriodSubmodule_isZLattice : IsZLattice ℝ (genuinePeriodSubmodule X) where
  span_top := (periodLattice_discrete_and_span X).2

/--
A compact fundamental domain for the period lattice: the closure of the parallelepiped
spanned by a `ℤ`-basis of `Λ` (which exists because `Λ` is a full lattice).
-/
theorem exists_compact_genuinePeriodFundamentalDomain :
    ∃ D : Set (Fin (analyticGenus ℂ X) → ℂ),
      IsCompact D ∧
      ∀ v : Fin (analyticGenus ℂ X) → ℂ, ∃ g ∈ genuinePeriodSubgroup X, v - g ∈ D := by
  haveI := ZLattice.module_free ℝ (genuinePeriodSubmodule X)
  haveI := ZLattice.module_finite ℝ (genuinePeriodSubmodule X)
  let bℤ : Module.Basis _ ℤ (genuinePeriodSubmodule X) := Module.Free.chooseBasis ℤ _
  let bR : Module.Basis _ ℝ (Fin (analyticGenus ℂ X) → ℂ) := bℤ.ofZLatticeBasis ℝ _
  refine ⟨closure (ZSpan.fundamentalDomain bR),
    (ZSpan.fundamentalDomain_isBounded bR).isCompact_closure, fun v => ?_⟩
  refine ⟨(ZSpan.floor bR v : Fin _ → ℂ), ?_, ?_⟩
  · have hmem : (ZSpan.floor bR v : Fin _ → ℂ) ∈ Submodule.span ℤ (Set.range bR) :=
      (ZSpan.floor bR v).property
    have hSub : genuinePeriodSubmodule X = Submodule.span ℤ (Set.range bR) :=
      (Module.Basis.ofZLatticeBasis_span (K := ℝ) (b := bℤ)).symm
    exact (SetLike.ext_iff.mp hSub _).mpr hmem
  · rw [show v - (ZSpan.floor bR v : Fin _ → ℂ) = ZSpan.fract bR v from
      (ZSpan.fract_apply bR v).symm]
    exact subset_closure (ZSpan.fract_mem_fundamentalDomain bR v)

/--
**The period lattice of a compact Riemann surface**, bundled as a
`ComplexTorus.FullComplexLattice` in the basis-aligned model `ℂ^g`. Its carrier is the
genuine `genuinePeriodSubgroup X`; discreteness and cocompactness come from the classical
input `periodLattice_discrete_and_span`.
-/
noncomputable def genuinePeriodLattice :
    JacobianChallenge.ComplexTorus.FullComplexLattice (Fin (analyticGenus ℂ X) → ℂ) where
  subgroup := genuinePeriodSubgroup X
  isClosed := AddSubgroup.isClosed_of_discrete
  isDiscrete := genuinePeriodSubgroup_discrete X
  fundamentalDomain := (exists_compact_genuinePeriodFundamentalDomain X).choose
  fundamentalDomain_isCompact := (exists_compact_genuinePeriodFundamentalDomain X).choose_spec.1
  fundamentalDomain_covers := (exists_compact_genuinePeriodFundamentalDomain X).choose_spec.2

@[simp] theorem genuinePeriodLattice_subgroup :
    (genuinePeriodLattice X).subgroup = genuinePeriodSubgroup X := rfl

end JacobianChallenge.Periods
