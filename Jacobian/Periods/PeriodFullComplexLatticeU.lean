import Jacobian.Periods.GenuinePeriodLatticeDiscrete

/-!
# Universe-polymorphic period `FullComplexLattice`

The period lattice of a compact Riemann surface `X : Type u`, bundled as a
`ComplexTorus.FullComplexLattice (Fin (analyticGenus ℂ X) → ℂ)`, so that the public
`Jacobian (X : Type u)` in `Jacobian/Solution.lean` can be wired as

  `ULift.{u} (ComplexTorus.quotient (Fin (genus X) → ℂ) (periodFullComplexLatticeU X))`.

**History.** Until the independent repair this capstone assembled the
`basisAlignedPeriodSubgroupConcreteU` chain, whose period pairing used the integration
placeholder `0`; the subgroup was therefore `⊥` (an in-tree lemma said so,
`basisAlignedPeriodSubgroupConcreteU_eq_bot`) and the "Jacobian" was all of `ℂ^g`. It
now delegates to the genuine lattice `genuinePeriodLattice X`
(`Jacobian/Periods/GenuinePeriodLattice.lean`): the subgroup generated by integrals of
the basis forms over closed chains of chart segments. Discreteness and fullness come from
`periodLattice_discrete_and_span` (`Jacobian/Periods/GenuinePeriodLatticeDiscrete.lean`),
which is proved — not assumed.
-/

namespace JacobianChallenge.Periods

open JacobianChallenge.HolomorphicForms

universe u

variable (X : Type u) [TopologicalSpace X] [T2Space X] [CompactSpace X]
  [ConnectedSpace X] [ChartedSpace ℂ X]
  [IsManifold (modelWithCornersSelf ℂ ℂ) (⊤ : WithTop ℕ∞) X]
  [FiniteDimensionalHolomorphicOneForms ℂ X]

/--
The period lattice of a compact Riemann surface `X : Type u`, bundled as a
`FullComplexLattice` in the basis-aligned model `Fin (analyticGenus ℂ X) → ℂ`:
the genuine lattice of integrals of holomorphic 1-forms over closed curves.
Discreteness and fullness are supplied by the proved
`periodLattice_discrete_and_span`.
-/
noncomputable def periodFullComplexLatticeU :
    JacobianChallenge.ComplexTorus.FullComplexLattice
      (Fin (analyticGenus ℂ X) → ℂ) :=
  genuinePeriodLattice X

@[simp] theorem periodFullComplexLatticeU_subgroup :
    (periodFullComplexLatticeU X).subgroup = genuinePeriodSubgroup X := rfl

end JacobianChallenge.Periods
